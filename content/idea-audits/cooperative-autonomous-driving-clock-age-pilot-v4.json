        "none",
        "step"
      ],
      "deadlineMs": [
        50,
        100,
        200
      ]
    },
    "pairedWorldRule": {
      "deadlineGapMs": 12,
      "sameFields": [
        "payload",
        "message order",
        "sender publish timestamp",
        "receiver receipt timestamp",
        "MCAP log timestamp",
        "RTT observation",
        "PTP-like point",
        "provenance sidecar",
        "network service-process id and all queue, serialization, and receiver-processing durations"
      ],
      "variedHiddenFactors": [
        "sender clock offset and drift differ between paired worlds",
        "sender relock state is held fixed within each pair and varied across the preregistered grid",
        "forward and reverse one-way propagation delay differ between paired worlds"
      ],
      "requiredWitness": "The same observable trace must be fresh in one world and stale in the other for the same deadline. Forward/reverse propagation may trade off to preserve the same RTT; the declared queue and service process may not change. Relock mismatch and post-relock recovery are tested separately so a valid paired-world provenance counter is not falsified by construction."
    },
    "intervalInputFirewall": "The interval method receives only observation plus the calibration artifact. It receives no test age, one-way delay, sender clock truth, or truth verdict. Missing clock_domain, validity, rate, or relock evidence returns [0,+infinity] and uncertain.",
    "calibrationRule": "Draw calibration mapping residuals within +/-18 ms and rate residuals within +/-120 ppm, then use the maximum absolute residual plus fixed guards of 2 ms and 2 ppm. Apply each transform from an anchor 2000 sender-clock ms before the message so rate and rate uncertainty participate in the mapping. A verified common clock has zero cross-domain mapping uncertainty.",
    "metricDefinitions": {
      "clusteredCoverage": "Fraction of episode clusters in which every evaluated true age is inside the reported point or interval; Wilson 95% interval over cluster successes.",
      "falseFresh": "Fraction of episode clusters containing at least one fresh verdict on a stale truth, conditional on a stale event in the cluster.",
      "falseStale": "Fraction of episode clusters containing at least one stale verdict on a fresh truth, conditional on a fresh event in the cluster.",
      "zeroEventUpper95": "For zero observed cluster events, one-sided 95% bound 1-0.05^(1/n).",
      "uncertainRate": "Mean per-episode fraction of uncertain verdicts.",
      "intervalWidthMs": "Mean finite interval width and fraction of infinite-width intervals.",
      "decisionCost": "Mean per-episode cost with false-fresh=10, false-stale=4, uncertain=1, correct=0."
    },
    "stopThresholds": {
      "minimumCriticalRegimeClusters": 400,
      "minimumClusteredCoverage": 0.99,
      "maximumZeroFalseFreshUpper95": 0.01,
      "maximumBoundedUncertainRate": 0.1,
      "minimumPairedWitnesses": 400,
      "minimumUnknownDomainUncertainRate": 0.99,
      "minimumRelockTransitionUncertainRate": 0.99,
      "minimumRelockStableDecisionAccuracy": 0.99,
      "minimumCommonClockDecisionAccuracy": 0.99,
      "minimumAblationFailClosedRate": 0.99
    }
  },
  "methods": [
    {
      "id": "naive-direct-subtraction",
      "kind": "point",
      "definition": "fusion_use(receiver clock) minus sender publish timestamp, assuming numeric clocks are directly comparable"
