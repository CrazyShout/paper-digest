{
  "schemaVersion": "1.0.0",
  "auditId": "cooperative-autonomous-driving-cooperscene-take9-frame-alignment-audit-2026-07-31",
  "directionId": "cooperative-autonomous-driving",
  "auditedAt": "2026-07-31",
  "purpose": "Determine, without downloading the complete scene ZIP or full MCAP, whether official scene-9 ZIP frame names can be mapped verifiably to official scene-9 LiDAR timestamps.",
  "auditConclusion": {
    "mappingClass": "none",
    "passed": false,
    "scope": "No exact all-frame mapping passes the audit standard. The ordinal rule is independently supported at 12 first/middle/last YAML anchors, three per agent, but the remaining 149 frame ordinals per agent were not independently pose-anchored and no publisher-supplied filename-to-MCAP sidecar or converter contract was found.",
    "ordinalCandidateRule": "For agent a and ZIP frame f in 540600..540760, candidate ordinal i=f-540600 selects the i-th strictly increasing /a_LIDAR message. At the 12 audited anchors, YAML lidar_pose -> MCAP /tf translation -> exact /tf-to-LiDAR timestamp/frame_id verifies this candidate.",
    "candidateResults": {
      "exact": false,
      "offset": false,
      "affine": false,
      "ordinal": false,
      "none": true
    },
    "ordinalCandidateEvidence": [
      "For moving agents 1, 2, and 3, all nine sampled YAML translations uniquely match the expected /tf ordinal within 1e-9 m; the largest observed component error is 4.973799150320701e-14 m.",
      "For every agent and all 161 records, the /tf record and corresponding LiDAR record have exactly equal MCAP log_time and exactly equal protobuf timestamp; every LiDAR frame_id is <agent>_base_link.",
      "Agent 0 has a static, non-unique pose. The official converter groups equal filename stems across agents, and all 161 agent-0 and agent-1 MCAP log_time values are exactly equal, so the uniquely pose-anchored agent-1 ordinal disambiguates agent 0.",
      "ZIP filename sequences and MCAP timestamps are both strictly monotone and duplicate-free."
    ],
    "strictBlockingPoint": "The 12 anchors do not exclude an unobserved dropped, duplicated, or shifted filename-to-MCAP association inside the unsampled intervals. Accepting all 161 rows from equal counts and sorted order would violate the audit prohibition.",
    "minimumUnblockAction": "Range-read only the remaining small YAML members for moving agents 1, 2, and 3, match every lidar_pose translation uniquely to that agent's /tf records, bridge static agent 0 through the official same-stem grouping plus its exact 161-row log_time equality with agent 1, then emit and validate a 644-row sidecar with per-row ZIP member hash, agent/frame key, MCAP log_time, protobuf timestamp, frame_id, pose residual, uniqueness count, and missing/duplicate/monotonicity checks. No PCD, PNG, full ZIP, or full-MCAP payload download is required.",
    "notClaimed": [
      "No exact, constant-offset, or exact affine numeric conversion from filename integer to protobuf timestamp exists.",
      "The sampled ordinal evidence is not reported as a strict all-frame mapping.",
      "No offset or affine parameters were selected from perception-model results.",
      "No full ZIP or full MCAP was downloaded."
    ]
  },
