  "title": "研究 Idea 审计中心",
  "summary": "七个长期方向已重新执行站内线索复核、站外一手检索、候选碰撞、可证伪研究设计和独立盲评。页面保留所有进入盲评的研究档案、真实最低分与淘汰原因；进入候选池不等于建议立项。",
  "workflow": {
    "label": "Evidence-first blind review",
    "principle": "本站论文只提供检索种子，不能定义相关工作的全集。每个方向都先核验问题是否真实、最近工作是否已覆盖、公开资产能否支撑可证伪实验；候选池冻结后由未参与检索与写作的筛选者独立决定 shortlist，再交给隔离评审者打分。",
    "releaseRule": "独立筛选必须覆盖候选总账并绑定候选池快照。进入 dossier 后先由两个互补视角盲评；任一评审出现实质性缺口即提前淘汰。只有此前评审均无缺口时才继续补齐五个独立视角，完整 panel 的所有维度及总体分都达到发布分后才可标记通过。",
    "reviewRules": [
      "检索者、独立筛选者、dossier 作者和盲评者角色分离，筛选输入不含历史 shortlist，评审提示不包含发布阈值、历史分数或其他评审意见。",
      "页面展示逐维最低分而不是平均分，任何低分报告都不能被删除、稀释或用宽松评审替换。",
      "缺少开箱即用代码本身不是淘汰理由；核心变量不可观测、关键资产不可得或最小实验不能识别主张才是。",
      "未通过候选保留最强反对意见、决定性实验和一手证据，供未来资产变化后重新判断。"
    ],
    "searchPolicy": {
      "localCorpusRole": "线索库、组内兴趣约束和已深读证据入口，不作为相关工作的全集。",
      "dateWindow": "以 2026-08-01 为本轮截止日，覆盖近年直接竞品、正式 proceedings、最新预印本，并追溯定义问题所需的奠基工作。",
      "sourcePriority": [
        "会议或期刊正式页面、论文 PDF、标准原文和官方项目页",
        "arXiv 原始记录及修订历史；存在正式版本时同时保留正式页与 arXiv",
        "固定 commit、release、checkpoint、数据卡与许可证；仓库存在不等于方案可执行"
      ],
      "venueScope": [
        "CVPR / ICCV / ECCV / WACV",
        "ICRA / IROS / CoRL",
        "NeurIPS / ICML / ICLR",
        "安全、软件工程、通信、标准与方向相关期刊"
      ],
      "queryExpansion": [
        "任务名 + limitation / failure / deployment / closed-loop",
        "候选 estimand + 最近直接方法 + 功能等价同义词",
        "数据、代码、checkpoint、许可证、接口和未发布资产",
        "负结果、不可识别性、泄漏、选择偏差和跨平台外推"
      ]
    },
    "steps": [
      {
        "id": "scope",
        "number": "01",
        "title": "问题与意义",
        "question": "失败是否对应真实任务代价、科学判断或系统决策，而不只是榜单增益？",
        "deliverable": "固定研究对象、受影响决策、证据边界和可推翻的问题陈述。",
        "failAction": "只有主观直觉、注入 fixture 或不可观察的部署假设时停止。"
      },
      {
        "id": "retrieve",
        "number": "02",
        "title": "多源检索",
        "question": "本库之外的正式论文、预印本、标准和公开资产已经推进到哪里？",
        "deliverable": "查询审计、canonical-ID 去重证据、正式版与 arXiv 双链接及固定资产账本。",
        "failAction": "一手来源不足、来源身份不明或关键链接无法核验时不生成候选。"
      },
      {
        "id": "collision",
        "number": "03",
        "title": "碰撞与独立筛选",
        "question": "问题、机制、estimand 或决定性实验是否已被最近工作功能等价覆盖，去偏筛选者是否仍愿意送审？",
        "deliverable": "逐候选最近工作差分、跨方向归属、完整淘汰 ledger，以及绑定候选池快照的独立筛选报告。",
        "failAction": "改名、换 backbone、成熟方法迁移或纯工程组合直接淘汰。"
      },
      {
        "id": "dossier",
        "number": "04",
        "title": "研究档案",
        "question": "能否把残余问题写成有依赖边界、强基线和停止条件的最小研究？",
        "deliverable": "完整 dossier：假设、方法、资产、自建模块、实验、指标、成功与 kill 条件。",
        "failAction": "无法给出 6–12 周内的可证伪 Gate 0/1 时不进入盲评。"
      },
      {
        "id": "blind-review",
        "number": "05",
        "title": "隔离盲评",
        "question": "独立评审重新打开一手证据后，是否仍认为贡献、实现和比较闭环没有缺口？",
        "deliverable": "五维整数分、逐项理由、最强反对意见、决定性实验与重开证据。",
        "failAction": "任一维度或总体未达到发布分即提前淘汰，禁止平均分补救。"
      },
      {
        "id": "revise",
        "number": "06",
        "title": "修订或止损",
        "question": "缺口是一个可补齐的小边界，还是会改变核心研究命题？",
        "deliverable": "保留新版本 lineage，或记录不能靠措辞修复的淘汰原因。",
        "failAction": "基础事件、因果识别、执行路径或公平对比不成立时停止迭代。"
      },
      {
        "id": "global-review",
        "number": "07",
        "title": "全局终审",
        "question": "跨七个方向看，搜索是否充分、证据是否独立、候选是否重复且整体值得投入？",
        "deliverable": "由未参与前序工作的评审者提交全局评分、反对意见和下一轮要求。",
        "failAction": "全局终审未通过时如实发布审计结果，不把候选包装成推荐。"
      }
    ],
    "gates": [
      {
        "id": "significance",
        "label": "研究意义",
        "threshold": 75,
        "description": "问题有可核验的任务代价、科学价值或系统决策后果。"
      },
      {
        "id": "headroom",
        "label": "突破余量",
        "threshold": 55,
        "description": "最近工作仍留下可测、可利用且没有被直接覆盖的失败轴。"
      },
      {
        "id": "novelty",
        "label": "新颖空间",
        "threshold": 65,
        "description": "相对直接竞品存在问题定义、estimand 或机制层面的不可替代差异。"
      },
      {
        "id": "feasibility",
        "label": "最小闭环",
        "threshold": 70,
        "description": "公开资产和自建路径足以在限定周期内证伪核心假设。"
      }
    ],
    "stopRules": [
      "最新工作已经覆盖相同问题、机制和验证对象，剩余只是不影响结论的实现差异。",
      "自然事件不存在或只能人工注入，且注入能力不能证明现实发生性。",
      "核心干预、状态身份、独立真值或公平基线不可获得，最小实验无法识别主张。",
      "把最小研究缩减到限定周期后，样本、资产或比较范围不足以支撑原贡献边界。"
    ]
  },
