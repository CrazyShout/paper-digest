---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import NotebookDocs from "../../../components/NotebookDocs.jsx";
import {
  getMarkdownHeadings,
  getPaperWithTag,
  getPapers,
  markdownToHtml
} from "../../../lib/content.js";
import { getNotebookData } from "../../../lib/navigation.js";

export async function getStaticPaths() {
  const papers = await getPapers();
  return papers.map((paper) => ({
    params: { id: paper.id }
  }));
}

const { id } = Astro.params;
const [result, notebook] = await Promise.all([
  getPaperWithTag(id),
  getNotebookData(import.meta.env.BASE_URL)
]);

if (!result) {
  return Astro.redirect(notebook.base);
}

const { paper, tags } = result;
const reportHtml = markdownToHtml(paper.body, { headingIds: true });
const toc = getMarkdownHeadings(paper.body)
  .filter((heading) => heading.level === 2)
  .map((heading) => ({
    depth: 2,
    title: heading.text,
    url: `#${heading.id}`
  }));
---

<BaseLayout
  title={`${paper.title} · Paper Digest`}
  description={paper.comment}
  canonicalPath={`papers/${paper.id}/`}
  type="article"
>
  <NotebookDocs
    tree={notebook.tree}
    pathname={Astro.url.pathname}
    params={Astro.params}
    title={paper.title}
    description={paper.comment}
    eyebrow="Paper Report"
    toc={toc}
    searchUrl={`${notebook.base}assets/notebook-search.json`}
    homeUrl={notebook.base}
    client:load
  >
    <div class="paper-tag-list">
      {tags.map((tagItem) => (
        <span class="paper-tag" style={`--tag-color: ${tagItem.color}`}>{tagItem.label}</span>
      ))}
    </div>

    <section class="paper-detail-meta" aria-label="论文元数据">
      <dl class="paper-meta-list">
        <div>
          <dt>抓取位置</dt>
          <dd>
            {paper.sourceLinks?.length > 0 ? (
              <span class="paper-source-links">
                {paper.sourceLinks.map((link) => (
                  <a href={link.url} target="_blank" rel="noopener noreferrer">
                    {link.label} <span aria-hidden="true">↗</span>
                    <span class="sr-only">（在新窗口打开）</span>
                  </a>
                ))}
              </span>
            ) : paper.source}
          </dd>
        </div>
        <div>
          <dt>作者</dt>
          <dd>{paper.authors.join(", ")}</dd>
        </div>
        <div>
          <dt>单位</dt>
          <dd>{paper.affiliations.join("; ")}</dd>
        </div>
      </dl>
      <div class="paper-detail-actions">
        <button class="share-link" type="button" data-share-button>
          <span data-share-label role="status" aria-live="polite">分享链接</span>
        </button>
      </div>
    </section>

    <article class="paper-report" set:html={reportHtml} />
  </NotebookDocs>

  <script is:inline>
    const shareButton = document.querySelector("[data-share-button]");
    const shareLabel = shareButton?.querySelector("[data-share-label]");

    async function copyShareLink() {
      const shareData = {
        title: document.title.replace(" · Paper Digest", ""),
        url: window.location.href
      };

      if (navigator.share) {
        await navigator.share(shareData);
        return "已打开分享";
      }

      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(shareData.url);
      } else {
        const input = document.createElement("textarea");
        input.value = shareData.url;
        input.setAttribute("readonly", "");
        input.style.position = "fixed";
        input.style.opacity = "0";
        document.body.appendChild(input);
        input.select();
        document.execCommand("copy");
        input.remove();
      }
      return "已复制链接";
    }

    shareButton?.addEventListener("click", async () => {
      try {
        const message = await copyShareLink();
        if (shareLabel) shareLabel.textContent = message;
      } catch (error) {
        if (shareLabel) shareLabel.textContent = "复制失败";
      }

      window.setTimeout(() => {
        if (shareLabel) shareLabel.textContent = "分享链接";
      }, 1800);
    });
  </script>
</BaseLayout>
