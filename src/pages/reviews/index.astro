---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NotebookDocs from "../../components/NotebookDocs.jsx";
import { getNotebookData, routeUrl } from "../../lib/navigation.js";
import { reviewCenterFingerprint } from "../../lib/review-fingerprint.js";

const notebook = await getNotebookData(import.meta.env.BASE_URL);
const center = notebook.reviewCenter;
const directions = center.directions || [];
const contentFingerprint = reviewCenterFingerprint(center);
const referenceCount = directions.reduce(
  (sum, direction) => sum + direction.references.length,
  0
);
const externalCount = directions.reduce(
  (sum, direction) => sum
    + direction.references.filter((reference) => reference.origin === "external").length,
  0
);
const writingModel = center.writingModel || {};
const sampleSurvey = writingModel.sampleSurvey || {};
const citationSnapshot = sampleSurvey.citationSnapshot || {};
const sampleAuthors = Array.isArray(sampleSurvey.authors)
  ? sampleSurvey.authors.join(", ")
  : sampleSurvey.authors;
const updatedLabel = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
  timeZone: "Asia/Shanghai"
}).format(new Date(`${center.updatedAt}T00:00:00+08:00`));
const toc = [
  { depth: 2, title: "综述方法", url: "#reviewMethodTitle" },
  { depth: 2, title: "方向综述", url: "#reviewDirectionsTitle" }
];
---

<BaseLayout
  title="综述中心 · Paper Digest"
  description={center.summary}
  canonicalPath="reviews/"
>
  <NotebookDocs
    tree={notebook.tree}
    pathname={Astro.url.pathname}
    params={Astro.params}
    title={center.title}
    description={center.summary}
    eyebrow={`Survey Center · 更新于 ${updatedLabel}`}
    toc={toc}
    searchUrl={`${notebook.base}assets/notebook-search.json`}
    homeUrl={notebook.base}
    client:load
  >
    <div
      data-review-version={center.version}
      data-review-updated={center.updatedAt}
      data-review-directions={directions.length}
      data-review-fingerprint={contentFingerprint}
    >
      <dl class="doc-meta-grid" aria-label="综述中心统计">
        <div>
          <dt>关注方向</dt>
          <dd>{directions.length}</dd>
        </div>
        <div>
          <dt>引用文献</dt>
          <dd>{referenceCount}</dd>
        </div>
        <div>
          <dt>站外扩展</dt>
          <dd>{externalCount}</dd>
        </div>
      </dl>

      <section class="review-index-intro" aria-labelledby="reviewMethodTitle">
        <header class="idea-section-head">
          <div>
            <p class="eyebrow">Editorial Method</p>
            <h2 id="reviewMethodTitle">从论文清单走向问题地图</h2>
          </div>
          <p>
            每篇方向综述同时覆盖本库已经深读的论文与尚未进入简报的重要工作，围绕概念边界、技术演化、方法谱系、评测协议和开放问题组织叙事。
          </p>
        </header>

        {sampleSurvey.title && (
          <article class="review-sample-survey">
            <p class="eyebrow">Writing Model</p>
            <h3>
              <a href={sampleSurvey.url} target="_blank" rel="noopener noreferrer">
                {sampleSurvey.title} <span aria-hidden="true">↗</span>
              </a>
            </h3>
            <p>{[sampleAuthors, sampleSurvey.venue, sampleSurvey.year].filter(Boolean).join(" · ")}</p>
            {Number.isFinite(citationSnapshot.count) && (
              <dl class="doc-meta-grid">
                <div>
                  <dt>引用快照</dt>
                  <dd>{citationSnapshot.count.toLocaleString("zh-CN")} 次</dd>
                </div>
                <div>
                  <dt>查询来源</dt>
                  <dd>{citationSnapshot.provider}</dd>
                </div>
                <div>
                  <dt>查询日期</dt>
                  <dd>{citationSnapshot.checkedAt}</dd>
                </div>
              </dl>
            )}
            {citationSnapshot.note && <p>{citationSnapshot.note}</p>}
          </article>
        )}

        {Array.isArray(writingModel.principles) && writingModel.principles.length > 0 && (
          <section class="review-writing-principles">
            <h3>借鉴的组织原则</h3>
            <ol>
              {writingModel.principles.map((principle) => <li>{principle}</li>)}
            </ol>
          </section>
        )}
      </section>

      <section class="review-index-directions" aria-labelledby="reviewDirectionsTitle">
        <header class="idea-section-head">
          <div>
            <p class="eyebrow">Directions</p>
            <h2 id="reviewDirectionsTitle">{directions.length} 条持续更新的研究主线</h2>
          </div>
          <p>每份综述都有独立地址，可直接分享并跳转到具体章节和参考文献。</p>
        </header>

        <div class="review-index-grid">
          {directions.map((direction, index) => {
            const localCount = direction.references
              .filter((reference) => reference.origin === "local").length;
            const externalDirectionCount = direction.references.length - localCount;
            return (
              <article class="review-index-card" style={`--review-color: ${direction.color}`}>
                <div class="review-index-card-number">{String(index + 1).padStart(2, "0")}</div>
                <div class="review-index-card-copy">
                  <p class="eyebrow">{direction.label}</p>
                  <h3>
                    <a href={routeUrl(notebook.base, `reviews/${direction.id}`)}>
                      {direction.title}
                    </a>
                  </h3>
                  <p>{direction.subtitle}</p>
                  <p>{direction.abstract}</p>
                  <dl>
                    <div>
                      <dt>检索窗口</dt>
                      <dd>{direction.searchWindow}</dd>
                    </div>
                    <div>
                      <dt>文献构成</dt>
                      <dd>{localCount} 篇本库 · {externalDirectionCount} 篇外部</dd>
                    </div>
                  </dl>
                </div>
                <a href={routeUrl(notebook.base, `reviews/${direction.id}`)}>
                  阅读 <span aria-hidden="true">→</span>
                </a>
              </article>
            );
          })}
        </div>
      </section>
    </div>
  </NotebookDocs>
</BaseLayout>
