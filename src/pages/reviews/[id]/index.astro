---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import NotebookDocs from "../../../components/NotebookDocs.jsx";
import ReviewReference from "../../../components/ReviewReference.astro";
import { getReviewCenter } from "../../../lib/content.js";
import { getNotebookData, routeUrl } from "../../../lib/navigation.js";

export async function getStaticPaths() {
  const center = await getReviewCenter();
  return center.directions.map((direction) => ({
    params: { id: direction.id }
  }));
}

const notebook = await getNotebookData(import.meta.env.BASE_URL);
const center = notebook.reviewCenter;
const direction = center.directions.find((item) => item.id === Astro.params.id);

if (!direction) {
  return Astro.redirect(routeUrl(notebook.base, "reviews"));
}

const directionIndex = center.directions.findIndex((item) => item.id === direction.id);
const previousDirection = center.directions[directionIndex - 1];
const nextDirection = center.directions[directionIndex + 1];
const reviewedLabel = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
  timeZone: "Asia/Shanghai"
}).format(new Date(`${direction.reviewedAt}T00:00:00+08:00`));
const localReferenceCount = direction.references
  .filter((reference) => reference.origin === "local").length;
const externalReferenceCount = direction.references.length - localReferenceCount;
const toc = [
  { depth: 2, title: "主要问题", url: "#research-questions" },
  ...direction.sections.map((section) => ({
    depth: 2,
    title: section.title,
    url: `#${section.id}`
  })),
  { depth: 2, title: "综合结论", url: "#takeaways" },
  { depth: 2, title: "检索记录", url: "#search-audit" },
  { depth: 2, title: "参考文献", url: "#references" }
];
---

<BaseLayout
  title={`${direction.title} · 综述中心`}
  description={direction.abstract}
  canonicalPath={`reviews/${direction.id}/`}
  type="article"
>
  <NotebookDocs
    tree={notebook.tree}
    pathname={Astro.url.pathname}
    params={Astro.params}
    title={direction.title}
    description={direction.abstract}
    eyebrow={`${direction.label} · 方向综述`}
    toc={toc}
    searchUrl={`${notebook.base}assets/notebook-search.json`}
    homeUrl={notebook.base}
    client:load
  >
    <dl class="review-detail-meta">
      <div>
        <dt>最近复核</dt>
        <dd>{reviewedLabel}</dd>
      </div>
      <div>
        <dt>引用构成</dt>
        <dd>{localReferenceCount} 本库 · {externalReferenceCount} 扩展</dd>
      </div>
    </dl>

    <article class="review-article">
      <section class="review-questions" id="research-questions" aria-labelledby="researchQuestionsTitle">
        <h2 id="researchQuestionsTitle">主要问题</h2>
        <ol>
          {direction.researchQuestions.map((question) => <li>{question}</li>)}
        </ol>
      </section>


      {direction.sections.map((section) => (
        <section class="review-section" id={section.id} aria-labelledby={`${section.id}-title`}>
          <header>
            <h2 id={`${section.id}-title`}>{section.title}</h2>
            <p>{section.thesis}</p>
          </header>
          <div class="review-prose" set:html={section.bodyHtml} />
          {section.references.length > 0 && (
            <aside class="review-section-sources" aria-label={`${section.title}引用文献`}>
              <strong>本节关键文献</strong>
              <div>
                {section.references.map((reference) => (
                  <ReviewReference reference={reference} compact />
                ))}
              </div>
            </aside>
          )}
        </section>
      ))}

      <section class="review-takeaways" id="takeaways" aria-labelledby="takeawaysTitle">
        <h2 id="takeawaysTitle">综合结论</h2>
        <ol>
          {direction.takeaways.map((takeaway) => <li>{takeaway}</li>)}
        </ol>
      </section>

      <details class="reading-disclosure review-search-audit" id="search-audit">
        <summary id="searchAuditTitle">检索记录与来源说明</summary>
        <p>{direction.subtitle}</p>
        <p>{direction.searchAudit.evidenceBoundary}</p>
        <dl class="review-search-stats">
          <div>
            <dt>检索窗口</dt>
            <dd>{direction.searchWindow}</dd>
          </div>
          <div>
            <dt>检索截止</dt>
            <dd>{direction.searchAudit.cutoffDate}</dd>
          </div>
          <div>
            <dt>来源覆盖</dt>
            <dd>{direction.searchAudit.sourceFamilies.length} 类</dd>
          </div>
          <div>
            <dt>候选去重</dt>
            <dd>
              {direction.searchAudit.counts.candidates}
              {" → "}
              {direction.searchAudit.counts.deduplicated}
            </dd>
          </div>
          <div>
            <dt>纳入文献</dt>
            <dd>{direction.searchAudit.counts.included}</dd>
          </div>
        </dl>
        <div class="review-search-columns">
          <div>
            <h3>实际覆盖的查询族</h3>
            <ol>
              {direction.searchAudit.queryFamilies.map((query) => <li>{query}</li>)}
            </ol>
          </div>
          <div>
            <h3>仍需持续追踪</h3>
            <ul>
              {direction.searchAudit.openSearchGaps.map((gap) => <li>{gap}</li>)}
            </ul>
          </div>
        </div>
        <p>
          {direction.searchAudit.independentReview.status === "passed"
            ? (direction.searchAudit.independentReview.scope?.startsWith("Editorial")
              ? "文案及本库候选审计已独立复核；一手来源的实质复核日期见页首，历史站外检索记录保留。"
              : `已由 ${direction.searchAudit.independentReview.reviewers} 位独立审阅者复核，共 ${direction.searchAudit.independentReview.rounds} 轮。`)
            : "本轮独立复核仍在进行，当前内容不会进入正式发布。"}
        </p>
      </details>


      <section class="review-bibliography" id="references" aria-labelledby="referencesTitle">
        <header>
          <div>
            <h2 id="referencesTitle">参考文献</h2>
          </div>
          <p>已收录论文可阅读本站报告，其余链接前往原论文。</p>
        </header>
        <ol>
          {direction.references.map((reference, index) => (
            <li>
              <span class="review-reference-number">{String(index + 1).padStart(2, "0")}</span>
              <ReviewReference reference={reference} />
            </li>
          ))}
        </ol>
      </section>

      <nav class="review-direction-pagination" aria-label="相邻方向综述">
        {previousDirection ? (
          <a href={routeUrl(notebook.base, `reviews/${previousDirection.id}`)}>
            <span>上一篇</span>
            <strong>{previousDirection.label}</strong>
          </a>
        ) : <span></span>}
        {nextDirection ? (
          <a href={routeUrl(notebook.base, `reviews/${nextDirection.id}`)}>
            <span>下一篇</span>
            <strong>{nextDirection.label}</strong>
          </a>
        ) : <span></span>}
      </nav>
    </article>
  </NotebookDocs>
</BaseLayout>
