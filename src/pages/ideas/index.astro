---
import BaseLayout from "../../layouts/BaseLayout.astro";
import IdeaCard from "../../components/IdeaCard.astro";
import { getIdeaCenter } from "../../lib/content.js";

const center = await getIdeaCenter();
const readyDirection = center.directions.find((direction) => direction.status === "ready");
const activeDirectionId = readyDirection?.id || center.directions[0]?.id;
const readyIdeas = center.directions.flatMap((direction) => direction.ideas || []);
const updatedLabel = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit"
}).format(new Date(`${center.updatedAt}T00:00:00+08:00`));
---

<BaseLayout
  title="Idea 中心 · Paper Digest"
  description={center.summary}
  stylesheet="../assets/styles.css"
  canonicalPath="ideas/"
>
  <div class="idea-site">
    <header class="idea-site-header">
      <a class="idea-home-link" href="../" aria-label="返回 Paper Digest 首页">
        <span>PD</span>
        <strong>Paper Digest</strong>
      </a>
      <nav aria-label="Idea 中心页面导航">
        <a href="#workflow">探索工作流</a>
        <a href="#workspace">方向工作台</a>
        <a href="../">返回简报</a>
      </nav>
    </header>

    <main class="idea-main">
      <section class="idea-hero" aria-labelledby="ideaCenterTitle">
        <div class="idea-hero-copy">
          <p class="eyebrow">Idea Center · 更新于 {updatedLabel}</p>
          <h1 id="ideaCenterTitle">{center.title}</h1>
          <p>{center.summary}</p>
        </div>
        <dl class="idea-hero-stats" aria-label="Idea 中心统计">
          <div>
            <dt>已深挖方向</dt>
            <dd>{center.directions.filter((direction) => direction.status === "ready").length}</dd>
          </div>
          <div>
            <dt>候选 Idea</dt>
            <dd>{readyIdeas.length}</dd>
          </div>
          <div>
            <dt>核心一手证据</dt>
            <dd>{readyDirection?.explorationRun?.coreEvidenceCount || 0}</dd>
          </div>
        </dl>
      </section>

      <section class="idea-workflow" id="workflow" aria-labelledby="workflowTitle">
        <header class="idea-section-head">
          <div>
            <p class="eyebrow">Research Funnel</p>
            <h2 id="workflowTitle">先判断值不值得做，再探索怎么做</h2>
          </div>
          <p>{center.workflow.principle}</p>
        </header>

        <ol class="workflow-steps">
          {center.workflow.steps.map((step) => (
            <li>
              <span class="workflow-number">{step.number}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.question}</p>
              </div>
              <div class="workflow-output">
                <strong>产出</strong>
                <p>{step.deliverable}</p>
              </div>
              <div class="workflow-stop">
                <strong>不过关</strong>
                <p>{step.failAction}</p>
              </div>
            </li>
          ))}
        </ol>

        <div class="workflow-gates">
          <div class="workflow-gates-copy">
            <p class="eyebrow">Hard Gates</p>
            <h3>四道硬门槛</h3>
            <p>阈值用于阻止“看起来有趣但没有研究闭环”的题目进入榜单。任何一项未过线，都只记录原因，不包装成 Idea。</p>
          </div>
          <dl>
            {center.workflow.gates.map((gate) => (
              <div>
                <dt>{gate.label}</dt>
                <dd><strong>≥ {gate.threshold}</strong><span>{gate.description}</span></dd>
              </div>
            ))}
          </dl>
        </div>

        <details class="workflow-policy">
          <summary>查看检索政策与全局停止规则</summary>
          <div>
            <section>
              <h3>检索不是只翻本站论文</h3>
              <p><strong>本站角色：</strong>{center.workflow.searchPolicy.localCorpusRole}</p>
              <p><strong>时间窗口：</strong>{center.workflow.searchPolicy.dateWindow}</p>
              <ul>{center.workflow.searchPolicy.sourcePriority.map((item) => <li>{item}</li>)}</ul>
            </section>
            <section>
              <h3>查询扩展</h3>
              <ul>{center.workflow.searchPolicy.queryExpansion.map((item) => <li>{item}</li>)}</ul>
            </section>
            <section>
              <h3>全局停止规则</h3>
              <ul>{center.workflow.stopRules.map((item) => <li>{item}</li>)}</ul>
            </section>
          </div>
        </details>
      </section>

      <section class="idea-workspace" id="workspace" aria-labelledby="workspaceTitle">
        <aside class="idea-direction-rail">
          <div>
            <p class="eyebrow">Directions</p>
            <h2 id="workspaceTitle">选择方向</h2>
          </div>
          <div class="idea-direction-tabs" role="tablist" aria-label="研究方向">
            {center.directions.map((direction) => (
              <button
                type="button"
                role="tab"
                id={`direction-tab-${direction.id}`}
                aria-controls={`direction-panel-${direction.id}`}
                aria-selected={direction.id === activeDirectionId ? "true" : "false"}
                tabindex={direction.id === activeDirectionId ? "0" : "-1"}
                data-direction-target={direction.id}
                style={`--direction-color: ${direction.color}`}
              >
                <span>{direction.label}</span>
                <small>{direction.status === "ready" ? `${direction.ideas.length} 个 Idea` : "待深挖"}</small>
              </button>
            ))}
          </div>
          <p class="idea-direction-note">方向切换不代表已经得出 Idea。只有完成检索并通过四道门槛的方向才会发布候选方案。</p>
        </aside>

        <div class="idea-direction-panels">
          {center.directions.map((direction) => (
            <section
              class="idea-direction-panel"
              id={`direction-panel-${direction.id}`}
              role="tabpanel"
              aria-labelledby={`direction-tab-${direction.id}`}
              data-direction-panel={direction.id}
              hidden={direction.id !== activeDirectionId}
            >
              {direction.status === "ready" ? (
                <>
                  <header class="idea-direction-head" style={`--direction-color: ${direction.color}`}>
                    <p class="eyebrow">Exploration Run · {direction.explorationRun.runId}</p>
                    <h2>{direction.label}</h2>
                    <p class="idea-direction-subtitle">{direction.subtitle}</p>
                    <p>{direction.scope}</p>
                  </header>

                  <section class="exploration-verdict" aria-labelledby={`${direction.id}-verdict`}>
                    <div>
                      <p class="eyebrow">Decision</p>
                      <h3 id={`${direction.id}-verdict`}>本轮判断</h3>
                    </div>
                    <p>{direction.explorationRun.verdict}</p>
                  </section>

                  <section class="exploration-audit" aria-labelledby={`${direction.id}-audit`}>
                    <header class="idea-subsection-head">
                      <div>
                        <p class="eyebrow">Gate Review</p>
                        <h3 id={`${direction.id}-audit`}>方向准入审计</h3>
                      </div>
                      <p>{direction.explorationRun.searchWindow}</p>
                    </header>
                    <div class="exploration-gates">
                      {direction.explorationRun.gates.map((gate) => (
                        <article>
                          <div>
                            <span>{gate.result}</span>
                            <strong>{gate.score}</strong>
                          </div>
                          <h4>{gate.label}</h4>
                          <p>{gate.judgement}</p>
                        </article>
                      ))}
                    </div>
                  </section>

                  <section class="saturation-audit" aria-labelledby={`${direction.id}-saturation`}>
                    <header class="idea-subsection-head">
                      <div>
                        <p class="eyebrow">Saturation Audit</p>
                        <h3 id={`${direction.id}-saturation`}>是不是已经做到极限</h3>
                      </div>
                      <p>{direction.explorationRun.saturation.verdict}</p>
                    </header>
                    <div class="saturation-columns">
                      <section>
                        <h4>高竞争区</h4>
                        <ol>
                          {direction.explorationRun.saturation.crowdedZones.map((zone) => (
                            <li>
                              <strong>{zone.title}</strong>
                              <p>{zone.evidence}</p>
                              <span>{zone.decision}</span>
                            </li>
                          ))}
                        </ol>
                      </section>
                      <section>
                        <h4>仍有余量</h4>
                        <ol>
                          {direction.explorationRun.saturation.openZones.map((zone) => (
                            <li>
                              <strong>{zone.title}</strong>
                              <p>{zone.whyOpen}</p>
                            </li>
                          ))}
                        </ol>
                      </section>
                    </div>
                  </section>

                  <section class="solution-families" aria-labelledby={`${direction.id}-solutions`}>
                    <header class="idea-subsection-head">
                      <div>
                        <p class="eyebrow">Solution Space</p>
                        <h3 id={`${direction.id}-solutions`}>通过门槛后，展开解法空间</h3>
                      </div>
                      <p>优先迁移能改变决策目标的机制，不局限于协同感知已有模块。</p>
                    </header>
                    <ol>
                      {direction.explorationRun.solutionFamilies.map((family) => (
                        <li>
                          <span>{family.borrowedFrom}</span>
                          <strong>{family.title}</strong>
                          <p>{family.use}</p>
                        </li>
                      ))}
                    </ol>
                  </section>

                  <section class="problem-signals" aria-labelledby={`${direction.id}-signals`}>
                    <header class="idea-subsection-head">
                      <div>
                        <p class="eyebrow">Problem Map</p>
                        <h3 id={`${direction.id}-signals`}>尚未解决的问题地图</h3>
                      </div>
                      <p>{direction.problemSignals.length} 条信号来自真实系统、前沿论文和相邻研究线的交叉核对。</p>
                    </header>
                    <ol>
                      {direction.problemSignals.map((signal, index) => (
                        <li>
                          <span>{String(index + 1).padStart(2, "0")}</span>
                          <div>
                            <h4>{signal.title}</h4>
                            <p>{signal.detail}</p>
                          </div>
                          <strong>{signal.status}</strong>
                        </li>
                      ))}
                    </ol>
                  </section>

                  <details class="frontier-evidence">
                    <summary>查看本轮前沿检索与关键一手证据</summary>
                    <div class="frontier-evidence-body">
                      <div class="frontier-search-meta">
                        <p><strong>来源口径：</strong>{direction.explorationRun.sourcePolicy}</p>
                        <p><strong>覆盖 venue：</strong>{direction.explorationRun.venueScope.join(" / ")}</p>
                        <p><strong>查询族：</strong>{direction.explorationRun.queryFamilies.join("；")}</p>
                      </div>
                      <ol>
                        {direction.explorationRun.frontierEvidence.map((source) => (
                          <li>
                            <div>
                              <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title}</a>
                              <span>{source.venue} · {source.year}</span>
                            </div>
                            <p>{source.finding}</p>
                          </li>
                        ))}
                      </ol>
                    </div>
                  </details>

                  <section class="idea-ranked-list" aria-labelledby={`${direction.id}-ideas`}>
                    <header class="idea-subsection-head">
                      <div>
                        <p class="eyebrow">Ranked Ideas</p>
                        <h3 id={`${direction.id}-ideas`}>通过审计的候选 Idea</h3>
                      </div>
                      <p>{center.scoring.disclaimer}</p>
                    </header>
                    {direction.ideas.map((idea) => (
                      <IdeaCard idea={idea} scoring={center.scoring} />
                    ))}
                  </section>
                </>
              ) : (
                <section class="idea-direction-pending" style={`--direction-color: ${direction.color}`}>
                  <p class="eyebrow">Queued Direction</p>
                  <h2>{direction.label}</h2>
                  <p class="idea-direction-subtitle">{direction.subtitle}</p>
                  <p>该方向尚未完成意义、前沿、饱和度、新颖性和可行性审计，因此暂不展示未经验证的 Idea。</p>
                  <ol>
                    {center.workflow.gates.map((gate) => (
                      <li><span>{gate.label}</span><strong>待检索评分</strong></li>
                    ))}
                  </ol>
                </section>
              )}
            </section>
          ))}
        </div>
      </section>
    </main>

    <footer class="idea-footer">
      <p>Paper Digest · Idea Center</p>
      <p>研究判断会随新论文、复现实验和真实数据更新。</p>
    </footer>
  </div>

  <script is:inline src="../assets/ideas.js"></script>
</BaseLayout>
