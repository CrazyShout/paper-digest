---
import BaseLayout from "../layouts/BaseLayout.astro";
import Sidebar from "../components/Sidebar.astro";
import SearchHeader from "../components/SearchHeader.astro";
import NotesDrawer from "../components/NotesDrawer.astro";
---

<BaseLayout title="Paper Digest">
  <div class="site-shell">
    <Sidebar />

    <main class="reader">
      <SearchHeader />
      <section class="search-results" id="searchResults" hidden></section>
      <article class="issue" id="digestArticle"></article>
    </main>

    <NotesDrawer />
  </div>

  <script is:inline src="assets/runtime-config.js"></script>
  <script is:inline src="assets/data.js"></script>
  <script is:inline src="assets/site.js"></script>
</BaseLayout>
