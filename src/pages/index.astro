---
import BaseLayout from "../layouts/BaseLayout.astro";
import NotebookDocs from "../components/NotebookDocs.jsx";
import ReviewCenterPreview from "../components/ReviewCenterPreview.astro";
import { getNotebookData, routeUrl } from "../lib/navigation.js";
import { HOME_DESCRIPTION } from "../lib/reading-ui.js";
import { getMarkdownHeadings } from "../lib/content.js";

const notebook = await getNotebookData(import.meta.env.BASE_URL);
const latest = notebook.digests[0];
const latestUrl = routeUrl(notebook.base, `digests/${latest.id}`);
const landscapeUrl = routeUrl(notebook.base, "landscape");
const visiblePapers = latest.papers.slice(0, 5);
const legacyDigestAnchors = [
  "discussion",
  ...getMarkdownHeadings(latest.body).map((heading) => heading.id),
  ...latest.tags.flatMap((tag) => [`section-${tag.id}`, `title-${tag.id}`])
];
---

<BaseLayout title="论文简报 · Paper Digest" description={HOME_DESCRIPTION} canonicalPath="">
  <NotebookDocs tree={notebook.tree} pathname={Astro.url.pathname} params={Astro.params}
    title="论文简报" description={HOME_DESCRIPTION} eyebrow="Paper Digest"
    searchUrl={`${notebook.base}assets/notebook-search.json`} homeUrl={notebook.base}
    showFooter={false} client:load>
    <div class="reading-home">
      <section class="home-latest" id="digestArticle" aria-labelledby="latest-title">
        <header>
          <p class="home-section-label">最新一期 · {latest.displayDate || latest.date} · {latest.papers.length} 篇论文</p>
          <h2 id="latest-title"><a href={latestUrl}>{latest.title}</a></h2>
        </header>
        <ul class="home-paper-list">
          {visiblePapers.map((paper) => (
            <li>
              <h3><a href={routeUrl(notebook.base, `papers/${paper.id}`)}>{paper.title}</a></h3>
              <p>{paper.comment}</p>
              <div class="home-paper-meta">
                <span>{latest.tags.filter((tag) => paper.tags.includes(tag.id)).map((tag) => tag.label).join(" · ")}</span>
                {paper.sourceLinks?.[0] && (
                  <a href={paper.sourceLinks[0].url} target="_blank" rel="noopener noreferrer">
                    {paper.sourceLinks[0].label} <span aria-hidden="true">↗</span>
                  </a>
                )}
              </div>
            </li>
          ))}
        </ul>
        <div class="home-section-links">
          <a href={latestUrl}>阅读完整简报与讨论 <span aria-hidden="true">→</span></a>
          <a href={routeUrl(notebook.base, "digests")}>全部 {notebook.digests.length} 期简报</a>
        </div>
      </section>

      <ReviewCenterPreview center={notebook.reviewCenter} basePath={notebook.base} />

      <section class="home-research" aria-labelledby="home-research-title">
        <header>
          <h2 id="home-research-title">研究态势与想法</h2>
          <p class="home-section-label">更新于 {notebook.landscape.updatedAt}</p>
        </header>
        <p>{notebook.landscape.title}</p>
        <div class="home-section-links">
          <a href={landscapeUrl}>查看趋势、证据与研究建议 <span aria-hidden="true">→</span></a>
          <a href={routeUrl(notebook.base, "ideas")}>研究想法与评审</a>
        </div>
      </section>
    </div>
  </NotebookDocs>

  <script is:inline define:vars={{ landscapeUrl, latestUrl, legacyDigestAnchors }}>
    // Keep links shared before the compact homepage pointed at their full text.
    function resolveReadingAnchor() {
      let hash;
      try { hash = decodeURIComponent(location.hash.slice(1)); } catch { return; }
      const landscapeAnchors = new Set([
        "researchLandscape", "landscapeTitle", "directionCoverageTitle", "trendTitle",
        "hotspotTitle", "opportunityTitle", "directionAdviceTitle"
      ]);
      if (landscapeAnchors.has(hash) || hash.startsWith("landscape-group-")) {
        location.replace(`${landscapeUrl}#${encodeURIComponent(hash)}`);
      } else if (legacyDigestAnchors.includes(hash)) {
        location.replace(`${latestUrl}#${encodeURIComponent(hash)}`);
      }
    }
    resolveReadingAnchor();
    window.addEventListener("hashchange", resolveReadingAnchor);
  </script>
</BaseLayout>
