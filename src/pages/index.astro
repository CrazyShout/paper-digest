---
import BaseLayout from "../layouts/BaseLayout.astro";
import Sidebar from "../components/Sidebar.astro";
import SearchHeader from "../components/SearchHeader.astro";
import NotesDrawer from "../components/NotesDrawer.astro";
import ResearchLandscape from "../components/ResearchLandscape.astro";
import { getResearchLandscape } from "../lib/content.js";

const researchLandscape = await getResearchLandscape();
---

<BaseLayout
  title="Paper Digest · 论文简报与研究态势"
  description={researchLandscape.summary}
  canonicalPath=""
>
  <div class="site-shell">
    <Sidebar />

    <main class="reader">
      <SearchHeader />
      <section
        class="search-results"
        id="searchResults"
        aria-live="polite"
        aria-busy="false"
        hidden
      ></section>
      <ResearchLandscape landscape={researchLandscape} />
      <article class="issue" id="digestArticle"></article>
    </main>

    <NotesDrawer />
  </div>

  <script is:inline src="assets/runtime-config.js"></script>
  <script is:inline src="assets/data.js"></script>
  <script is:inline src="assets/site.js"></script>
</BaseLayout>
