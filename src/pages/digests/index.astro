---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NotebookDocs from "../../components/NotebookDocs.jsx";
import { getNotebookData, routeUrl } from "../../lib/navigation.js";

const notebook = await getNotebookData(import.meta.env.BASE_URL);
const summary = `共 ${notebook.digests.length} 期，按发布时间排列。`;
---

<BaseLayout
  title="简报归档 · Paper Digest"
  description={summary}
  canonicalPath="digests/"
>
  <NotebookDocs
    tree={notebook.tree}
    pathname={Astro.url.pathname}
    params={Astro.params}
    title="简报归档"
    description={summary}
    searchUrl={`${notebook.base}assets/notebook-search.json`}
    homeUrl={notebook.base}
    client:load
  >
    <div class="digest-archive">
      {notebook.digests.map((digest, index) => (
        <article>
          <div class="archive-entry">
            <p class="archive-meta">
              <time datetime={digest.date}>{digest.displayDate || digest.date}</time>
              <span>{digest.papers.length} 篇论文</span>
              {index === 0 && <span>最新一期</span>}
            </p>
            <h2>
              <a href={routeUrl(notebook.base, `digests/${digest.id}`)}>{digest.title}</a>
            </h2>
            <p class="archive-summary">{digest.summary}</p>
            <details class="archive-directions">
              <summary>涉及 {digest.tags.length} 个方向</summary>
              <ul>
                {digest.tags.map((tag) => (
                  <li><a href={routeUrl(notebook.base, `digests/${digest.id}`) + `#section-${tag.id}`}>{tag.label}</a></li>
                ))}
              </ul>
            </details>
          </div>
        </article>
      ))}
    </div>
  </NotebookDocs>
</BaseLayout>
