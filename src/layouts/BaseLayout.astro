---
import "../styles/global.css";

const {
  title = "Paper Digest",
  description = "周期性论文简报、详细阅读报告与研究趋势分析。",
  canonicalPath = "",
  type = "website"
} = Astro.props;

const siteUrl = "https://crazyshout.github.io/paper-digest/";
const canonicalUrl = new URL(String(canonicalPath).replace(/^\/+/, ""), siteUrl).toString();
const metaDescription = String(description).replace(/\s+/g, " ").trim().slice(0, 200);
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={metaDescription}>
  <meta name="theme-color" content="#f7f7f8">
  <link rel="canonical" href={canonicalUrl}>
  <meta property="og:locale" content="zh_CN">
  <meta property="og:type" content={type}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={metaDescription}>
  <meta property="og:url" content={canonicalUrl}>
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={metaDescription}>
</head>
<body class="min-h-screen bg-fd-background text-fd-foreground">
  <slot />
</body>
</html>
