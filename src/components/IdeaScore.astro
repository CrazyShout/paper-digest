---
const { score, scoring } = Astro.props;

const dimensions = scoring.dimensions.map((dimension) => ({
  ...dimension,
  value: score.dimensions[dimension.id]
}));
---

<section class="idea-score" aria-label={`${scoring.label} ${score.overall} 分`}>
  <div class="idea-score-summary">
    <span class="idea-score-number">{score.overall}</span>
    <span class="idea-score-total">/ 100</span>
    <strong>{score.band}</strong>
  </div>

  <dl class="idea-score-dimensions">
    {dimensions.map((dimension) => (
      <div>
        <dt>
          <span>{dimension.label}</span>
          <strong>{dimension.value}</strong>
        </dt>
        <dd>
          <span style={`--idea-score-value: ${dimension.value}%`}></span>
        </dd>
      </div>
    ))}
  </dl>
</section>
