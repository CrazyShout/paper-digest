---
const { score, scoring } = Astro.props;

const rawValues = Object.values(score.dimensions || {}).map(Number);
const inferredMax = Number(score.overall) <= 10 && rawValues.every((value) => value <= 10)
  ? 10
  : 100;
const maxScore = Number(scoring.maxScore || inferredMax);

const dimensions = scoring.dimensions.map((dimension) => ({
  ...dimension,
  value: score.dimensions[dimension.id]
}));
---

<section class="idea-score" aria-label={`${scoring.label} ${score.overall}/${maxScore}`}>
  <div class="idea-score-summary">
    <span class="idea-score-number">{score.overall}</span>
    <span class="idea-score-total">/ {maxScore}</span>
    {score.band && <strong>{score.band}</strong>}
  </div>

  <dl class="idea-score-dimensions">
    {dimensions.map((dimension) => (
      <div>
        <dt>{dimension.label}</dt>
        <dd>{dimension.value}<span> / {maxScore}</span></dd>
      </div>
    ))}
  </dl>
</section>
