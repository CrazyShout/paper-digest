---
import IdeaScore from "./IdeaScore.astro";
import BlindReviewSummary from "./BlindReviewSummary.astro";

const { idea, scoring } = Astro.props;

function dossierItem(item) {
  if (typeof item === "string") return { label: "", detail: item };
  if (!item || typeof item !== "object") return { label: "", detail: String(item || "") };

  const label = item.title || item.name || item.stage || item.type || item.asset || "";
  const ignored = new Set(["title", "name", "stage", "type", "asset"]);
  const detail = Object.entries(item)
    .filter(([key, value]) => !ignored.has(key) && value !== null && value !== undefined)
    .map(([key, value]) => {
      const normalized = Array.isArray(value) ? value.join("；") : String(value);
      const labels = {
        work: "工作",
        boundary: "边界",
        protocol: "协议",
        decision: "判据",
        role: "作用",
        definition: "定义",
        unit: "单位",
        duration: "周期",
        detail: "说明",
        mitigation: "控制"
      };
      return labels[key] ? `${labels[key]}：${normalized}` : normalized;
    })
    .filter(Boolean)
    .join("；");

  return { label, detail };
}

function renderList(items = []) {
  return items.map(dossierItem);
}

const reviewStatus = idea.reviewStatus || idea.blindReview?.status;
const statusLabel = {
  passed: "通过盲评",
  revise: "待关键实验",
  rejected: "本轮淘汰",
  candidate: "候选"
}[reviewStatus] || idea.decision;
---

<article class="idea-card" id={`idea-${idea.id}`}>
  <header class="idea-card-head">
    <div class="idea-rank" aria-label={`候选编号 ${idea.rank}`}>{String(idea.rank).padStart(2, "0")}</div>
    <div class="idea-card-title">
      <div class="idea-card-labels">
        {statusLabel && <span class={`is-${reviewStatus || "candidate"}`}>{statusLabel}</span>}
        {idea.output && <span>{idea.output}</span>}
      </div>
      <h3>{idea.title}</h3>
      <p class="idea-hook">{idea.hook}</p>
    </div>
    <a class="idea-anchor" href={`#idea-${idea.id}`} aria-label={`定位到 ${idea.title}`}>#</a>
  </header>

  <div class="idea-card-overview">
    {idea.score && <IdeaScore score={idea.score} scoring={scoring} />}

    <div class="idea-card-thesis">
      <dl class="idea-meta">
        <div>
          <dt>投入</dt>
          <dd>{idea.effort}</dd>
        </div>
        <div>
          <dt>首轮周期</dt>
          <dd>{idea.timeline}</dd>
        </div>
      </dl>

      <section>
        <h4>为什么是现在</h4>
        <p>{idea.whyNow}</p>
      </section>
      {idea.keyProblem ? (
        <section>
          <h4>关键问题</h4>
          <p>{idea.keyProblem}</p>
        </section>
      ) : (
        <section>
          <h4>尚未解决</h4>
          <p>{idea.unresolved}</p>
        </section>
      )}
      {idea.currentLimitations && (
        <section>
          <h4>现有工作不足</h4>
          <p>{idea.currentLimitations}</p>
        </section>
      )}
      {Array.isArray(idea.noveltyClaims) && idea.noveltyClaims.length > 0 && (
        <section class="idea-novelty">
          <h4>新颖性边界</h4>
          <ul>
            {idea.noveltyClaims.map((claim) => <li>{claim}</li>)}
          </ul>
        </section>
      )}
      <section class="idea-hypothesis">
        <h4>可证伪假设</h4>
        <p>{idea.hypothesis}</p>
      </section>
    </div>
  </div>

  {idea.blindReview && <BlindReviewSummary review={idea.blindReview} />}

  <details class="idea-dossier">
    <summary>展开完整研究档案</summary>
    <div class="idea-dossier-body">
      <section class="idea-method-section">
        <p class="eyebrow">Possible Approach</p>
        <h4>解决机制</h4>
        <ol>
          {renderList(idea.method).map((item) => (
            <li>
              {item.label && <strong>{item.label}</strong>}
              <span>{item.detail}</span>
            </li>
          ))}
        </ol>
      </section>

      {Array.isArray(idea.implementationPath) && (
        <section class="idea-implementation-section">
          <p class="eyebrow">Implementation Path</p>
          <h4>实现路径</h4>
          <ol>
            {renderList(idea.implementationPath).map((item) => (
              <li>
                {item.label && <strong>{item.label}</strong>}
                <span>{item.detail}</span>
              </li>
            ))}
          </ol>
        </section>
      )}

      <section class="idea-study-section">
        <p class="eyebrow">Minimum Study</p>
        <h4>最小研究闭环</h4>
        <ol>
          {renderList(idea.minimumStudy).map((item) => (
            <li>
              {item.label && <strong>{item.label}</strong>}
              <span>{item.detail}</span>
            </li>
          ))}
        </ol>
      </section>

      {(Array.isArray(idea.strongBaselines) || Array.isArray(idea.metrics)) && (
        <div class="idea-criteria-grid idea-experiment-grid">
          {Array.isArray(idea.strongBaselines) && (
            <section>
              <p class="eyebrow">Baselines</p>
              <h4>强基线</h4>
              <ul>
                {renderList(idea.strongBaselines).map((item) => (
                  <li>
                    {item.label && <strong>{item.label}</strong>}
                    <span>{item.detail}</span>
                  </li>
                ))}
              </ul>
            </section>
          )}
          {Array.isArray(idea.metrics) && (
            <section>
              <p class="eyebrow">Metrics</p>
              <h4>评价指标</h4>
              <ul>
                {renderList(idea.metrics).map((item) => (
                  <li>
                    {item.label && <strong>{item.label}</strong>}
                    <span>{item.detail}</span>
                  </li>
                ))}
              </ul>
            </section>
          )}
        </div>
      )}

      <div class="idea-criteria-grid">
        <section class="is-success">
          <p class="eyebrow">Go</p>
          <h4>继续投入的证据</h4>
          <ul>
            {renderList(idea.successCriteria).map((item) => (
              <li>
                {item.label && <strong>{item.label}</strong>}
                <span>{item.detail}</span>
              </li>
            ))}
          </ul>
        </section>
        <section class="is-kill">
          <p class="eyebrow">Stop</p>
          <h4>停止条件</h4>
          <ul>
            {renderList(idea.killCriteria).map((item) => (
              <li>
                {item.label && <strong>{item.label}</strong>}
                <span>{item.detail}</span>
              </li>
            ))}
          </ul>
        </section>
        <section class="is-risk">
          <p class="eyebrow">Risk</p>
          <h4>主要风险</h4>
          <ul>
            {renderList(idea.risks).map((item) => (
              <li>
                {item.label && <strong>{item.label}</strong>}
                <span>{item.detail}</span>
              </li>
            ))}
          </ul>
        </section>
      </div>

      {idea.impact && (
        <section class="idea-impact-section">
          <p class="eyebrow">Impact</p>
          <h4>潜在影响</h4>
          <p>{idea.impact}</p>
        </section>
      )}

      <section class="idea-evidence-section">
        <p class="eyebrow">Primary Evidence</p>
        <h4>关键相关工作</h4>
        <ol class="idea-evidence-list">
          {idea.evidence.map((source) => (
            <li>
              <div>
                <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title}</a>
                <span class={`idea-evidence-origin is-${source.localPaperId ? "local" : "external"}`}>
                  {source.localPaperId ? "本库深读" : "仓库外证据"}
                </span>
              </div>
              <p>{[source.venue, source.year, source.role].filter(Boolean).join(" · ")}</p>
              {Array.isArray(source.links) && source.links.length > 0 && (
                <div class="idea-evidence-links">
                  {source.links.map((link) => (
                    <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label}</a>
                  ))}
                </div>
              )}
              {source.localLink && (
                <a class="idea-local-paper" href={`../${source.localLink}`}>查看本库详细报告</a>
              )}
            </li>
          ))}
        </ol>
      </section>
    </div>
  </details>
</article>
