---
const { center } = Astro.props;
const directions = center?.directions || [];

function formatDate(value) {
  if (!value) return "持续更新";
  return new Intl.DateTimeFormat("zh-CN", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit"
  }).format(new Date(`${value}T00:00:00+08:00`));
}
---

<section class="review-preview" id="reviewCenterPreview" aria-labelledby="reviewPreviewTitle">
  <header class="review-preview-head">
    <div>
      <p class="eyebrow">Survey Center</p>
      <h2 id="reviewPreviewTitle">综述中心</h2>
      <p>{center.summary}</p>
    </div>
    <div class="review-preview-actions">
      <span>{directions.length} 个长期方向</span>
      <a href="reviews/">进入综述中心 <span aria-hidden="true">→</span></a>
    </div>
  </header>

  <div class="review-preview-grid">
    {directions.map((direction) => {
      const localCount = direction.references.filter((reference) => reference.origin === "local").length;
      const externalCount = direction.references.length - localCount;

      return (
        <article class="review-preview-card" style={`--review-color: ${direction.color}`}>
          <div class="review-preview-card-top">
            <span class="review-direction-mark" aria-hidden="true"></span>
            <span>{direction.label}</span>
          </div>
          <h3><a href={`reviews/${direction.id}/`}>{direction.title}</a></h3>
          <p>{direction.abstract}</p>
          <dl>
            <div>
              <dt>复核日期</dt>
              <dd>{formatDate(direction.reviewedAt)}</dd>
            </div>
            <div>
              <dt>证据构成</dt>
              <dd>{localCount} 本库 · {externalCount} 扩展</dd>
            </div>
          </dl>
          <a class="review-preview-card-link" href={`reviews/${direction.id}/`}>
            阅读方向综述 <span aria-hidden="true">→</span>
          </a>
        </article>
      );
    })}
  </div>
</section>
