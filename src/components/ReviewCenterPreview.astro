---
const { center, basePath = "/" } = Astro.props;
---

<section class="home-directions" id="reviewCenterPreview" aria-labelledby="reviewPreviewTitle">
  <header>
    <h2 id="reviewPreviewTitle">按方向阅读</h2>
    <a href={`${basePath}reviews/`}>全部方向综述 <span aria-hidden="true">→</span></a>
  </header>
  <div class="home-direction-groups">
    {center.directionGroups.map((group) => (
      <section aria-labelledby={`preview-group-${group.id}`}>
        <h3 id={`preview-group-${group.id}`}>{group.label}</h3>
        <ul>
          {group.directions.map((direction) => (
            <li><a href={`${basePath}reviews/${direction.id}/`} title={direction.title}>{direction.label}</a></li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</section>
