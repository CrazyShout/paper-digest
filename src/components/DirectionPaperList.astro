---
import { routeUrl } from "../lib/navigation.js";
const { papers, tags, base } = Astro.props;
---
<ul class="direction-paper-list">
  {papers.map((paper) => (
    <li>
      <p class="direction-paper-kind">{paper.primary ? "本方向" : `关联阅读 · ${tags.find((tag) => tag.id === paper.tags[0])?.label || "其他方向"}`}</p>
      <h3><a href={routeUrl(base, `papers/${paper.id}`)}>{paper.title}</a></h3>
      <p>{paper.comment}</p>
      <a class="direction-paper-report" href={routeUrl(base, `papers/${paper.id}`)}>完整报告 →</a>
    </li>
  ))}
</ul>
