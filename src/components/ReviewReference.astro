---
const {
  reference,
  compact = false
} = Astro.props;

const isExternal = reference.origin === "external";
const badge = reference.badge || (isExternal ? "外部文献" : "本库已报告");
const meta = [
  reference.venue,
  reference.year,
  reference.publicationTypeLabel || reference.publicationType,
  reference.publicationStatusLabel || reference.publicationStatus
].filter(Boolean);
---

<article
  class:list={[
    "review-reference",
    compact && "is-compact",
    isExternal ? "is-external" : "is-local"
  ]}
>
  <div class="review-reference-heading">
    <span class:list={["review-origin-badge", isExternal ? "is-external" : "is-local"]}>
      {badge}
      {isExternal && <span aria-hidden="true">↗</span>}
    </span>
    {meta.length > 0 && <span class="review-reference-meta">{meta.join(" · ")}</span>}
  </div>

  <a
    class="review-reference-title"
    href={reference.href}
    target={isExternal ? "_blank" : undefined}
    rel={isExternal ? "noopener noreferrer" : undefined}
  >
    {reference.title}
    {isExternal && <span class="sr-only">（站外链接，在新窗口打开）</span>}
  </a>
  {reference.authors && <p class="review-reference-authors">{reference.authors}</p>}

  {!compact && (
    <>
      <dl class="review-reference-evidence">
        <div>
          <dt>用于支撑</dt>
          <dd>{reference.supports}</dd>
        </div>
        <div>
          <dt>证据边界</dt>
          <dd>{reference.limitation}</dd>
        </div>
      </dl>
      {reference.sourceLinks?.length > 0 && (
        <nav
          class="review-reference-sources"
          aria-label={`${reference.title} 的论文链接`}
        >
          <span>论文链接</span>
          {reference.sourceLinks.map((link) => (
            <a
              class="review-reference-source"
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              {link.label} <span aria-hidden="true">↗</span>
              <span class="sr-only">（在新窗口打开）</span>
            </a>
          ))}
        </nav>
      )}
    </>
  )}
</article>
