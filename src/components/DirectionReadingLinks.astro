---
import { routeUrl } from "../lib/navigation.js";
const { directions, base, id = "reading-directions", title = "按方向选读" } = Astro.props;
---
<section class="direction-reading-links" id={id} aria-labelledby={`${id}-title`}>
  <header>
    <h2 id={`${id}-title`}>{title}</h2>
    <a href={routeUrl(base, "directions")}>全部方向与历期论文 →</a>
  </header>
  <nav aria-label="选择研究方向">
    {directions.map((direction) => (
      <a href={routeUrl(base, `directions/${direction.id}`)}>
        <span>{direction.label}</span>
        <small>{direction.currentCount ? `本期 ${direction.currentCount} 篇` : direction.latest ? `最近 ${direction.latest.date.slice(5)}` : "综述入口"}</small>
      </a>
    ))}
  </nav>
</section>
