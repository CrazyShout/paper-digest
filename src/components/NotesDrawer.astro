<button class="notes-toggle" id="notesToggle" type="button" aria-label="打开组内笔记" aria-controls="notesDrawer" aria-expanded="false">
  <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
    <path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"></path>
  </svg>
</button>

<aside
  class="notes-drawer"
  id="notesDrawer"
  role="dialog"
  aria-modal="true"
  aria-labelledby="notesTitle"
  aria-hidden="true"
  inert
>
  <div class="notes-head">
    <div>
      <p class="eyebrow" id="notesIssue">Current Issue</p>
      <h3 id="notesTitle">组内笔记</h3>
    </div>
    <button class="close-notes" id="closeNotes" type="button" aria-label="关闭组内笔记">×</button>
  </div>
  <div class="note-stream" id="noteStream"></div>
  <form class="note-composer" id="noteComposer">
    <div class="note-identity">
      <div class="anon-avatar" id="anonAvatar" aria-hidden="true"></div>
      <div>
        <p class="note-identity-label">匿名身份</p>
        <strong id="anonName"></strong>
      </div>
      <button class="shuffle-identity" id="shuffleIdentity" type="button">换一个</button>
    </div>
    <label class="sr-only" for="noteText">笔记内容</label>
    <textarea id="noteText" placeholder="写一条简短笔记" maxlength="800" required></textarea>
    <button class="save-note" id="saveNote" type="submit">提交评论</button>
    <p class="note-hint" id="noteHint" role="status" aria-live="polite">部署评论 Worker 后会写入仓库；当前未配置时会保存在本机草稿。</p>
  </form>
</aside>
