---
import { routeUrl } from "../lib/navigation.js";
import { digestPaperGroups, digestReadingSections } from "../lib/digest-reading.js";
import { sourceDisplayLabel } from "../lib/reading-ui.js";

const {
  digest,
  basePath = "/",
  reading = digestReadingSections(digest.body),
  groups = digestPaperGroups(digest),
  headingLevel = 2,
  showHeader = true
} = Astro.props;
const Heading = `h${Math.min(6, Math.max(2, Number(headingLevel) || 2))}`;
---

<section class="digest-content" id="digestArticle" aria-label={`${digest.title} 简报`}>
  {showHeader && (
    <header class="digest-intro">
      <dl class="digest-meta-line" aria-label="本期简报统计">
        <div><dt>日期</dt><dd>{digest.displayDate || digest.date}</dd></div>
        <div><dt>论文</dt><dd>{digest.papers.length} 篇</dd></div>
        <div><dt>方向</dt><dd>{digest.tags.length} 个</dd></div>
      </dl>
    </header>
  )}

  {reading.introHtml && <section class="digest-note digest-lead" set:html={reading.introHtml} />}

  <nav class="digest-direction-links" aria-label="按方向选读">
    {groups.map(({ tag }) => <a href={`#section-${tag.id}`}>{tag.label}</a>)}
  </nav>

  {groups.map(({ tag, papers, related }) => (
    <section class="digest-section" id={`section-${tag.id}`} aria-labelledby={`title-${tag.id}`}>
      <header>
        <Heading id={`title-${tag.id}`}>{tag.label}</Heading>
        <p class="digest-section-count">
          {papers.length > 0 ? `${papers.length} 篇` : "相关论文"}
          {related.length > 0 && papers.length > 0 ? ` · 另有 ${related.length} 篇交叉阅读` : ""}
          <a href={routeUrl(basePath, `reviews/${tag.id}`)}>方向综述 <span aria-hidden="true">↗</span></a>
        </p>
      </header>
      {papers.length > 0 && (
        <div class="paper-list">
          {papers.map((paper) => (
            <article class="paper-card" id={`paper-${paper.id}`}>
              <h3><a href={routeUrl(basePath, `papers/${paper.id}`)}>{paper.title}</a></h3>
              <p class="paper-comment">{paper.comment}</p>
              <div class="paper-card-links">
                <a href={routeUrl(basePath, `papers/${paper.id}`)}>阅读全文 <span aria-hidden="true">→</span></a>
                {paper.sourceLinks?.map((link) => (
                  <a href={link.url} target="_blank" rel="noopener noreferrer">
                    {sourceDisplayLabel(link)} <span aria-hidden="true">↗</span>
                  </a>
                ))}
              </div>
              <details class="paper-card-details">
                <summary>作者与单位</summary>
                <dl class="paper-meta">
                  <div><dt>作者</dt><dd>{paper.authors.join(", ")}</dd></div>
                  <div><dt>单位</dt><dd>{paper.affiliations.join("; ")}</dd></div>
                </dl>
              </details>
            </article>
          ))}
        </div>
      )}
      {related.length > 0 && (
        <ul class="digest-related-list" aria-label={`${tag.label}交叉阅读`}>
          {related.map((paper) => <li><a href={`#paper-${paper.id}`}>{paper.title}</a><span>跳到本期条目 →</span></li>)}
        </ul>
      )}
    </section>
  ))}

  {reading.discussion.length > 0 && (
    <section class="digest-supplement" aria-label="延伸讨论">
      {reading.discussion.map((section) => <div class="digest-note" set:html={section.html} />)}
    </section>
  )}
  {reading.provenance.length > 0 && (
    <details class="reading-disclosure digest-provenance" id="digest-provenance">
      <summary>检索与来源说明</summary>
      {reading.provenance.map((section) => <div class="digest-note" set:html={section.html} />)}
    </details>
  )}
</section>
