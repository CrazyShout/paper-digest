{
  "name": "paper-digest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "validate": "node scripts/validate-content.mjs",
    "build": "npm run validate && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "feishu:preview": "node scripts/feishu-publish.mjs preview",
    "feishu:publish": "node scripts/feishu-publish.mjs publish",
    "email:preview": "node scripts/email-publish.mjs preview",
    "email:publish": "node scripts/email-publish.mjs publish"
  },
  "dependencies": {
    "astro": "^5.16.2",
    "nodemailer": "^6.10.2"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-arm64-gnu": "*"
  }
}
