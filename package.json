{
  "name": "paper-digest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "test": "node --test",
    "validate": "node scripts/validate-content.mjs && node scripts/validate-idea-center.mjs",
    "build": "npm run validate && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "review:preflight": "node scripts/review-workflow.mjs check",
    "review:prompt": "node scripts/review-workflow.mjs prompt",
    "idea:preflight": "node scripts/idea-workflow.mjs check",
    "idea:audit-validate": "node scripts/validate-idea-audit-pool.mjs",
    "idea:dossier-validate": "node scripts/validate-idea-dossier.mjs",
    "idea:review-gate": "node scripts/idea-review-gate.mjs",
    "idea:review-validate": "node scripts/validate-idea-review.mjs",
    "idea:validate": "node scripts/validate-idea-center.mjs",
    "idea:prompt": "node scripts/idea-workflow.mjs prompt",
    "feishu:preview": "node scripts/feishu-publish.mjs preview",
    "feishu:publish": "node scripts/feishu-publish.mjs publish",
    "email:check": "node scripts/email-publish.mjs check",
    "email:preview": "node scripts/email-publish.mjs preview",
    "email:publish": "node scripts/email-publish.mjs publish",
    "email:welcome:preview": "node scripts/email-publish.mjs welcome-preview",
    "email:welcome": "node scripts/email-publish.mjs welcome",
    "email:review-update:preview": "node scripts/email-publish.mjs review-update-preview",
    "email:review-update": "node scripts/email-publish.mjs review-update",
    "email:idea-update:preview": "node scripts/email-publish.mjs idea-update-preview",
    "email:idea-update": "node scripts/email-publish.mjs idea-update"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^5.16.2",
    "fumadocs-core": "^16.14.0",
    "fumadocs-ui": "^16.14.0",
    "lucide-react": "^1.28.0",
    "nodemailer": "^8.0.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-arm64-gnu": "*"
  }
}
