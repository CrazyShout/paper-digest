name = "paper-digest-comments"
main = "comments-worker.mjs"
compatibility_date = "2026-05-11"

[vars]
GITHUB_OWNER = "CrazyShout"
GITHUB_REPO = "paper-digest"
GITHUB_BRANCH = "main"
COMMENTS_DIR = "comments"
ALLOWED_ORIGIN = "https://crazyshout.github.io"

# Set this as a secret, never commit it:
# wrangler secret put GITHUB_TOKEN
